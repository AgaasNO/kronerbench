{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgaasNO/kronerbench/schemas/manifest.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "created_utc": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "analysis_plan_commit": {
      "type": "string"
    },
    "arguments": {
      "type": "object"
    },
    "profile": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "case_set_hash": {
      "type": "string"
    },
    "prompt_hashes": {
      "type": "object"
    },
    "models": {
      "type": "array"
    },
    "conditions": {
      "type": "array"
    },
    "dry_run": {
      "type": "boolean"
    },
    "total_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "interrupted"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "git_commit",
    "analysis_plan_commit",
    "arguments",
    "profile",
    "seed",
    "case_set_hash",
    "prompt_hashes",
    "models",
    "conditions",
    "dry_run",
    "total_cost_usd",
    "status"
  ]
}
