{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgaasNO/kronerbench/schemas/field.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "trial_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "suite": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "repeat": {
      "type": "integer"
    },
    "expected": {
      "type": "string"
    },
    "committed": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "correct",
        "correct_flag",
        "silent_error",
        "loud_flag",
        "loud_exhausted",
        "loud_no_call",
        "api_error"
      ]
    },
    "attempts": {
      "type": "integer"
    },
    "first_attempt_valid": {
      "type": "boolean"
    },
    "retry_drift": {
      "type": "boolean"
    },
    "retry_corruption": {
      "type": "boolean"
    },
    "cost_usd": {
      "type": "number"
    },
    "latency_ms": {
      "type": "number"
    },
    "digits": {
      "type": "integer"
    },
    "repeat_score": {
      "type": "number"
    },
    "sep_style": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "ambiguity": {
      "type": "string"
    },
    "distractors": {
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "trial_id",
    "case_id",
    "suite",
    "field",
    "model",
    "condition",
    "repeat",
    "expected",
    "committed",
    "outcome",
    "attempts",
    "first_attempt_valid",
    "retry_drift",
    "retry_corruption",
    "cost_usd",
    "latency_ms",
    "digits",
    "repeat_score",
    "sep_style",
    "currency",
    "lang",
    "ambiguity",
    "distractors"
  ]
}
